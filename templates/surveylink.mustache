{{!
    @template block_surveylinks/surveylink

    The view for the survey links block.

    Example context (json):
    {
        "surveylink" : {
            "surveyurl": "https://www.example.com",
            "surveyid": "test123",
            "surveyname": "Survey Name",
            "logosrc": "/pluginfile.php/foo/bar",
            "linktest": "<p>test</p>",
            "extratext": "<p>extra test</p>"
        }
    }
}}

{{#surveylink}}
<div class="survey-card">
  <div class="survey-content">
    <div class="survey-icon">
      <span class="icon-pencil">📝</span>
    </div>
    <div class="survey-text">
      <h3>Unit & Teaching Surveys</h3>
      <p>Your feedback helps us improve your learning experience.</p>
    </div>
  </div>
  <a href="{{ surveyurl }}" class="survey-button">Start Survey <span class="arrow">→</span></a>
</div>
{{/surveylink}}
